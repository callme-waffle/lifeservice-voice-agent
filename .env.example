# voice-agent 환경변수 입력 양식
#
# 1. 이 파일을 저장소 루트의 .env로 복사합니다.
# 2. 빈 값과 CHANGE_ME 값을 실제 환경에 맞게 입력합니다.
# 3. .env는 Git 추적 대상이 아니며 API 키·비밀번호·암호화 키를 커밋하지 않습니다.
#
# cp .env.example .env

# -----------------------------------------------------------------------------
# 애플리케이션
# -----------------------------------------------------------------------------

VOICE_AGENT_ENV=development
VOICE_AGENT_API_HOST=0.0.0.0
VOICE_AGENT_API_PORT=8000
VOICE_AGENT_LOG_LEVEL=INFO

# 초기 승인값: 웹과 전화를 합쳐 활성 세션 1개
VOICE_AGENT_MAX_ACTIVE_SESSIONS=1
VOICE_AGENT_SESSION_TIMEOUT_SECONDS=120
VOICE_AGENT_REQUEST_TIMEOUT_SECONDS=60

# -----------------------------------------------------------------------------
# GTX 1080 Ti 호스트 접근
# 실제 주소와 사용자명은 추적되지 않는 로컬 .env에만 입력합니다.
# -----------------------------------------------------------------------------

VOICE_AGENT_GPU_SSH_HOST=
VOICE_AGENT_GPU_SSH_PORT=22
VOICE_AGENT_GPU_SSH_USER=
VOICE_AGENT_GPU_SSH_KEY_PATH=
VOICE_AGENT_GPU_REMOTE_VENV=
VOICE_AGENT_GPU_HOST=
VOICE_AGENT_LAN_INTERFACE=
VOICE_AGENT_GPU_DEVICE=cuda:0
CUDA_VISIBLE_DEVICES=0

# 호스트 확인 후 기록할 값
VOICE_AGENT_NVIDIA_DRIVER_VERSION=
VOICE_AGENT_CUDA_VERSION=
VOICE_AGENT_CUDNN_VERSION=

# -----------------------------------------------------------------------------
# 내부 오디오 계약
# M4에서 확정한 내부 오디오 계약입니다.
# -----------------------------------------------------------------------------

VOICE_AGENT_AUDIO_ENCODING=pcm_s16le
VOICE_AGENT_AUDIO_SAMPLE_RATE_HZ=16000
VOICE_AGENT_AUDIO_CHANNELS=1
VOICE_AGENT_AUDIO_CHUNK_DURATION_MS=1000
VOICE_AGENT_AUDIO_QUEUE_MAX_CHUNKS=4

# -----------------------------------------------------------------------------
# STT
# 후보 예시: faster-whisper / transformers-whisper
# 모델 ID·정밀도는 GTX 1080 Ti 벤치마크 후 확정합니다.
# -----------------------------------------------------------------------------

VOICE_AGENT_STT_BACKEND=
VOICE_AGENT_STT_MODEL_ID=
VOICE_AGENT_STT_MODEL_PATH=
VOICE_AGENT_STT_DEVICE=cuda:0
VOICE_AGENT_STT_COMPUTE_TYPE=
VOICE_AGENT_STT_LANGUAGE=ko
VOICE_AGENT_STT_BEAM_SIZE=
VOICE_AGENT_STT_TIMEOUT_SECONDS=120
# 분리 배포에서는 두 모델 엔드포인트를 함께 설정합니다. GPU Compose는 loopback을 자동 주입합니다.
VOICE_AGENT_STT_ENDPOINT=

# -----------------------------------------------------------------------------
# 작업 처리 API
# API 키는 현재 세션에 제공된 테스트 키 또는 새 키를 .env에만 입력합니다.
# -----------------------------------------------------------------------------

VOICE_AGENT_TASK_API_BASE_URL=
VOICE_AGENT_TASK_APPROVED_HOST=
VOICE_AGENT_TASK_API_KEY=
# 백엔드 컨테이너는 실제 키 대신 /run/secrets 파일을 읽습니다. 로컬 직접 실행 때만 위 값을 사용합니다.
VOICE_AGENT_TASK_API_KEY_FILE=
VOICE_AGENT_TASK_MODEL=
VOICE_AGENT_TASK_TIMEOUT_SECONDS=60
VOICE_AGENT_TASK_MAX_RETRIES=0
VOICE_AGENT_TASK_TLS_VERIFY=true

# API 규격 확인 후 필요한 경우 변경합니다.
VOICE_AGENT_TASK_MODELS_PATH=/v1/models
VOICE_AGENT_TASK_CHAT_PATH=/v1/chat/completions

# -----------------------------------------------------------------------------
# TTS
# 후보 예시: MeloTTS-Korean / XTTS-v2
# 모델 ID·음성 ID·정밀도는 GTX 1080 Ti 벤치마크 후 확정합니다.
# -----------------------------------------------------------------------------

VOICE_AGENT_TTS_BACKEND=
VOICE_AGENT_TTS_MODEL_ID=
VOICE_AGENT_TTS_MODEL_PATH=
VOICE_AGENT_TTS_DEVICE=cuda:0
VOICE_AGENT_TTS_COMPUTE_TYPE=
VOICE_AGENT_TTS_LANGUAGE=ko
VOICE_AGENT_TTS_SPEAKER_ID=
VOICE_AGENT_TTS_SPEED=1.25
VOICE_AGENT_TTS_TIMEOUT_SECONDS=120
VOICE_AGENT_TTS_ENDPOINT=
# STT /ready 성공 후 TTS 기동 대기 시간(초). 사용자 선택 기본값.
TTS_START_DELAY_SECONDS=30

# 웹 WebSocket은 연결 수락 전 subprotocol token.<토큰>을 검증합니다.
# 실제 토큰을 채팅·로그·저장소에 넣지 않습니다.
VOICE_AGENT_WEB_ACCESS_TOKEN=
VOICE_AGENT_WEB_ACCESS_TOKEN_FILE=

# -----------------------------------------------------------------------------
# Grandstream HT813 FXO 직접 발신·전체 착신
# HOST와 로컬 주소는 추적되지 않는 로컬 .env에 입력합니다.
# 실제 SIP/RTP 통화·인증·허용 번호는 검증되지 않았습니다.
# FXS 전화기는 아직 연결되지 않았으며 FXS 측은 애플리케이션 SIP 계정이 아닙니다.
# -----------------------------------------------------------------------------

VOICE_AGENT_HT813_HOST=
VOICE_AGENT_HT813_FXO_SIP_PORT=5062
VOICE_AGENT_HT813_SIP_TRANSPORT=udp
VOICE_AGENT_HT813_LOCAL_IPV4=
VOICE_AGENT_HT813_LOCAL_SIP_PORT=5060
VOICE_AGENT_HT813_LOCAL_RTP_PORT=4000
VOICE_AGENT_HT813_SIP_USER_ID=
VOICE_AGENT_HT813_SIP_PASSWORD=
# 실제 허용 번호를 운영자가 설정하기 전에는 발신 객체를 생성하지 않습니다.
VOICE_AGENT_HT813_ALLOWED_EXACT=
VOICE_AGENT_HT813_ALLOWED_PREFIXES=
# 전체 FXO 외부 착신을 직접 SIP로 수신하려면 true. HT813 대상 설정·Gate 2 전에는 false.
VOICE_AGENT_HT813_INBOUND_ENABLED=false
VOICE_AGENT_HT813_INBOUND_SIP_PORT=5061
VOICE_AGENT_HT813_INBOUND_RTP_PORT=4002
# HT813 Caller ID Transport Type에 맞게 from/p-asserted-identity/p-preferred-identity/disabled 중 선택
VOICE_AGENT_HT813_CALLER_ID_HEADER=from
# 발화 종료: 16 kHz PCM 에너지, 연속 무음, 한 발화 최대 길이
VOICE_AGENT_HT813_VAD_ENERGY=400
VOICE_AGENT_HT813_VAD_SILENCE_MS=800
VOICE_AGENT_HT813_MAX_UTTERANCE_MS=15000
# 로컬 운영 API: loopback에서 Bearer VOICE_AGENT_WEB_ACCESS_TOKEN으로 /operator/calls 사용

# -----------------------------------------------------------------------------
# 과거 계획의 Asterisk 설정 (현재 서버 없음, 사용하지 않음)
# HT813 주소를 Asterisk HOST에 복사하지 않습니다.
# -----------------------------------------------------------------------------

VOICE_AGENT_ASTERISK_VERSION=
VOICE_AGENT_ASTERISK_INTERFACE=
VOICE_AGENT_ASTERISK_HOST=
VOICE_AGENT_ASTERISK_PORT=
VOICE_AGENT_ASTERISK_TEST_EXTENSION=
VOICE_AGENT_ASTERISK_MEDIA_CODEC=
VOICE_AGENT_ASTERISK_MEDIA_SAMPLE_RATE_HZ=

# ARI를 사용할 때 입력
VOICE_AGENT_ASTERISK_ARI_BASE_URL=
VOICE_AGENT_ASTERISK_ARI_USERNAME=
VOICE_AGENT_ASTERISK_ARI_PASSWORD=
VOICE_AGENT_ASTERISK_ARI_APP_NAME=voice-agent

# AudioSocket을 사용할 때 입력
VOICE_AGENT_ASTERISK_AUDIOSOCKET_BIND_HOST=0.0.0.0
VOICE_AGENT_ASTERISK_AUDIOSOCKET_BIND_PORT=9092

# 인증서 검증을 끄지 않는 것이 기본값입니다.
VOICE_AGENT_ASTERISK_TLS_VERIFY=true

# -----------------------------------------------------------------------------
# 녹취·원문 저장과 삭제
# 승인값: 생성 시점부터 30일 보존 후 삭제
# -----------------------------------------------------------------------------

VOICE_AGENT_RECORD_AUDIO=true
VOICE_AGENT_STORE_TRANSCRIPTS=true
VOICE_AGENT_RETENTION_DAYS=30
VOICE_AGENT_RETENTION_SWEEP_INTERVAL_SECONDS=3600
VOICE_AGENT_RECORDINGS_DIR=./data/recordings
VOICE_AGENT_TRANSCRIPTS_DIR=./data/transcripts
VOICE_AGENT_CALLS_DIR=./data/calls
VOICE_AGENT_DELETION_AUDIT_LOG=./data/deletion-audit.jsonl

# 32바이트 임의 키를 URL-safe Base64로 인코딩해 런타임에만 주입합니다. 실제 값은 출력·커밋하지 않습니다.
VOICE_AGENT_DATA_ENCRYPTION_KEY=
VOICE_AGENT_DATA_ENCRYPTION_KEY_FILE=
# 백엔드 Compose에서 사용하는 호스트 tmpfs 비밀 디렉터리 경로(실제 키 내용은 입력하지 않음)
VOICE_AGENT_SECRETS_DIR=

# -----------------------------------------------------------------------------
# 관측성
# 민감한 음성·원문은 일반 애플리케이션 로그에 포함하지 않습니다.
# -----------------------------------------------------------------------------

VOICE_AGENT_LOG_TRANSCRIPTS=false
VOICE_AGENT_LOG_AUDIO_PAYLOADS=false
# 추적 수신기는 작업 VM의 관리망 주소. 실제 토큰이나 전사 내용은 추적하지 않습니다.
OBSERVABILITY_HOST=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# Compose에서 모델/백엔드 지표를 관리망에 노출할 때만 설정합니다.
VOICE_AGENT_METRICS_HOST=
VOICE_AGENT_METRICS_PORT=8001
# Grafana 관리 비밀번호는 실행 환경에서 주입하고 이 파일에 실제 값을 두지 않습니다.
GRAFANA_ADMIN_PASSWORD=
