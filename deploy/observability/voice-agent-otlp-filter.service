[Unit]
Description=Limit voice-agent OTLP intake to the GPU VM
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/voice-agent/hosts.env
ExecStart=/usr/sbin/iptables -I DOCKER-USER 1 -i ${VOICE_AGENT_LAN_INTERFACE} -p tcp -m conntrack --ctorigdst ${OBSERVABILITY_HOST} --ctorigdstport 4318 ! -s ${VOICE_AGENT_GPU_HOST} -j REJECT
ExecStart=/usr/sbin/iptables -I INPUT 1 -i ${VOICE_AGENT_LAN_INTERFACE} -d ${OBSERVABILITY_HOST} -p tcp --dport 4318 ! -s ${VOICE_AGENT_GPU_HOST} -j REJECT
ExecStop=/usr/sbin/iptables -D INPUT -i ${VOICE_AGENT_LAN_INTERFACE} -d ${OBSERVABILITY_HOST} -p tcp --dport 4318 ! -s ${VOICE_AGENT_GPU_HOST} -j REJECT
ExecStop=/usr/sbin/iptables -D DOCKER-USER -i ${VOICE_AGENT_LAN_INTERFACE} -p tcp -m conntrack --ctorigdst ${OBSERVABILITY_HOST} --ctorigdstport 4318 ! -s ${VOICE_AGENT_GPU_HOST} -j REJECT

[Install]
WantedBy=multi-user.target
