[Unit]
Description=Limit voice-agent metrics to the observability VM
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/voice-agent/hosts.env
ExecStart=/usr/sbin/iptables -I INPUT 1 -d ${VOICE_AGENT_GPU_HOST} -p tcp -m multiport --dports 8001,8103,8104,9400 ! -s ${OBSERVABILITY_HOST} ! -i lo -j REJECT
ExecStop=/usr/sbin/iptables -D INPUT -d ${VOICE_AGENT_GPU_HOST} -p tcp -m multiport --dports 8001,8103,8104,9400 ! -s ${OBSERVABILITY_HOST} ! -i lo -j REJECT

[Install]
WantedBy=multi-user.target
